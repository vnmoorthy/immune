# Immune runs end to end with NO keys. Everything below is optional and lights up a sponsor integration.

# ClickHouse — real-time trace store + replay corpus. Local server: `pnpm clickhouse` (default below). ClickHouse Cloud: paste your HTTPS endpoint + credentials.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=immune

# Receipt signing secret (HMAC-SHA256). Set a real one in production.
IMMUNE_RECEIPT_SECRET=change-me

# LLM refiner (optional). Drafts a more general antibody + plain-English ruling; everything is still replay-proven before promotion.
# AkashML (OpenAI-compatible, open models on decentralized GPUs)
# OPENAI_BASE_URL=https://api.akashml.com/v1
# AKASHML_API_KEY=
# OPENAI_MODEL=meta-llama/Llama-3.3-70B-Instruct
# or OpenAI
# OPENAI_API_KEY=
# or Claude Code CLI on this machine
# IMMUNE_USE_CLAUDE_CLI=1

# Senso.ai — verified context layer where rulings are published as versioned documents and cited back to agents.
# Uses the official Senso CLI (installed in-project by scripts/demo.sh). No key in this file: run once and approve in the browser:
#   .tools/senso/node_modules/.bin/senso login
# Optional: pin the folder Immune publishes into (otherwise it creates "Immune · rulings" and caches the id in .immune/senso.json)
# SENSO_FOLDER_ID=

# Guild.ai — host the remediator agent. Log in once (.tools/guild/node_modules/.bin/guild auth login), publish per integrations/guild/README.md,
# then point the engine at the API trigger; breaches are dispatched there instead of running in-process.
# GUILD_TRIGGER_URL=
# GUILD_TRIGGER_KEY=
# IMMUNE_PUBLIC_API=https://<your-tunnel>.trycloudflare.com   # hosted Guild agents cannot reach localhost

# Semgrep — installed binary on PATH (brew install semgrep) or set a path
# SEMGREP_BIN=semgrep
