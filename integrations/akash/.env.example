# Immune — optional LLM refiner on AkashML (OpenAI-compatible inference)
# Copy to the repo root as .env (gitignored). Everything works with this file absent:
# the refiner is optional and every draft it produces is replay-proven before promotion.

# --- AkashML (checked first by packages/core/src/llm.ts) -------------------------------
# Base URL is AkashML's OpenAI-compatible endpoint (docs: akashml.com/docs/getting-started/introduction)
OPENAI_BASE_URL=https://api.akashml.com/v1
# Create under Settings -> API Keys in the AkashML console; shown once; starts with "akml-"
AKASHML_API_KEY=akml-REPLACE_ME
# Model id exactly as listed on akashml.com/docs/platform/models
#   meta-llama/Llama-3.3-70B-Instruct   default: cheap, fast, solid JSON mode
#   openai/gpt-oss-120b                 cheapest capable (flood demos)
#   Qwen/Qwen3.6-35B-A3B                long context, AkashML "haiku-class" pick
#   zai-org/GLM-5.3                     best rulings, AkashML "sonnet-class" pick
IMMUNE_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- Alternatives (used only if the AkashML pair above is not set) ----------------------
# OPENAI_API_KEY=sk-...                 # OpenAI proper, or any OpenAI-compatible server with OPENAI_BASE_URL
# IMMUNE_USE_CLAUDE_CLI=1               # use `claude -p` if the Claude Code CLI is on PATH

# --- Other sponsor integrations (documented in their own folders) -----------------------
# CLICKHOUSE_URL=http://localhost:8123  # integrations/../scripts/clickhouse.sh
# SENSO_API_KEY=tgr_...                 # integrations/senso/README.md
# GUILD_TRIGGER_URL=https://api.guild.ai/v1/workspaces/<owner>/<workspace>/sessions
# GUILD_TRIGGER_KEY=<api_key_id>:<api_key_secret>   # integrations/guild/README.md
# IMMUNE_RECEIPT_SECRET=change-me        # HMAC secret for receipts (default 'immune-dev-secret' is flagged in /api/status)
